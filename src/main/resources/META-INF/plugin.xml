<idea-plugin>
    <id>com.apifirst.mocking.studio</id>
    <name>API First &amp; Mocking Studio</name>
    <vendor url="https://github.com/JirakJ/api-first-mocking-studio">Jakub Jirák</vendor>

    <change-notes><![CDATA[
      <h3>2026.8.0</h3><ul><li>The plugin is now completely free — all features unlocked, no license needed.</li><li>Source code is now open source under Apache-2.0: https://github.com/JirakJ/api-first-mocking-studio</li></ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="API Explorer" 
                    secondary="false" 
                    anchor="right" 
                    factoryClass="com.jakumjirak.ApiExplorerToolWindowFactory"
                    icon="AllIcons.Actions.Search"/>
    
        <projectService serviceImplementation="com.jakumjirak.ApiFirstPluginSettings"/>
        <projectService serviceImplementation="com.jakumjirak.MockServerService"/>

        <projectConfigurable
            parentId="tools"
            instance="com.jakumjirak.ApiFirstConfigurable"
            id="apifirst.mocking.studio.settings"
            displayName="API First &amp; Mocking Studio"/>

        <notificationGroup id="API First &amp; Mocking Studio Feedback" displayType="BALLOON"/>
        <projectActivity implementation="com.jakumjirak.feedback.FeedbackNotifier"/>
    </extensions>

    <actions>
        <group id="ApiFirst.ToolsGroup" text="API First" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="ApiFirst.ToggleMockServer"
                    class="com.jakumjirak.ToggleMockServerAction"
                    text="Start Mock Server…"
                    description="Serve sample responses for every operation of an OpenAPI/Swagger file on 127.0.0.1"/>
            <action id="ApiFirst.GenerateHttpClient"
                    class="com.jakumjirak.GenerateHttpClientAction"
                    text="Generate HTTP Client File…"
                    description="Generate a JetBrains HTTP Client (.http) file from an OpenAPI/Swagger file"/>
        </group>
    </actions>
</idea-plugin>
