<idea-plugin>
    <id>com.apifirst.mocking.studio</id>
    <name>API First &amp; Mocking Studio</name>
    <vendor>JetBrains Plugin Developer</vendor>

    <change-notes><![CDATA[
      <h3>2026.8.0</h3><ul><li>The plugin is now completely free — all features unlocked, no license needed.</li><li>Source code is now open source under Apache-2.0: https://github.com/JirakJ/api-first-mocking-studio</li></ul>
    ]]></change-notes>

    <pluginIcon>pluginIcon.svg</pluginIcon>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="API Explorer" 
                    secondary="false" 
                    anchor="right" 
                    factoryClass="com.jakumjirak.ApiExplorerToolWindowFactory"
                    icon="AllIcons.Actions.Search"/>
    
        <projectService serviceImplementation="com.jakumjirak.ApiFirstPluginSettings"/>

        <projectConfigurable
            parentId="tools"
            instance="com.jakumjirak.ApiFirstConfigurable"
            id="apifirst.mocking.studio.settings"
            displayName="API First &amp; Mocking Studio"/>

        <notificationGroup id="API First &amp; Mocking Studio Feedback" displayType="BALLOON"/>
        <projectActivity implementation="com.jakumjirak.feedback.FeedbackNotifier"/>
    </extensions>

    <actions>
        <!-- Actions are added dynamically via Tool Window toolbar -->
    </actions>
</idea-plugin>
